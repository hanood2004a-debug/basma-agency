{
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/courses", "destination": "/graphic-course.dc.html" },
    { "source": "/graphic-course", "destination": "/graphic-course.dc.html" },
    { "source": "/graphic-course.html", "destination": "/graphic-course.dc.html" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/index.backup.html", "destination": "/", "permanent": true },
    { "source": "/index.preview.html", "destination": "/", "permanent": true },
    { "source": "/_seo_backup_20260805", "destination": "/", "permanent": true },
    { "source": "/_seo_backup_20260805/:path*", "destination": "/", "permanent": true },
    { "source": "/_i18n_backup_20260806", "destination": "/", "permanent": true },
    { "source": "/_i18n_backup_20260806/:path*", "destination": "/", "permanent": true },
    { "source": "/_crm_backup_20260806", "destination": "/", "permanent": true },
    { "source": "/_crm_backup_20260806/:path*", "destination": "/", "permanent": true }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}